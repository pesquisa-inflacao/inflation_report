# Copy this file to ".env" (same folder) and fill in real values.
# ".env" is gitignored and must NEVER be committed.

# --- Resend (email delivery) ---
# Get the key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender identity. FROM_EMAIL must be on a domain you have VERIFIED in Resend
# (SPF/DKIM). A plain @stanford.edu address will not pass verification unless
# you control that domain's DNS — in that case set FROM_EMAIL to a verified
# domain and put your @stanford.edu address in REPLY_TO instead.
FROM_EMAIL=relatorios@your-verified-domain.org
FROM_NAME=Pesquisa Inflação
REPLY_TO=youraddress@stanford.edu

# --- Report viewer ---
# Base URL of the GitHub Pages report viewer (usually no need to change).
BASE_URL=https://pesquisa-inflacao.github.io/inflation_report/site/index.html
